     "output_type": "stream",
     "text": [
      "Before ReLU:\n",
      "[[-2  3 -1]\n",
      " [ 4 -5  2]\n",
      " [-3  1  6]]\n",
      "\n",
      "After ReLU:\n",
      "[[0 3 0]\n",
      " [4 0 2]\n",
      " [0 1 6]]\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "\n",
    "feature_map = np.array([\n",
    "    [-2,  3, -1],\n",
    "    [ 4, -5,  2],\n",
    "    [-3,  1,  6]\n",
    "])\n",
    "\n",
    "\n",
    "def relu(x):\n",
    "    return np.maximum(0, x)\n",
    "\n",
    "\n",
    "result = relu(feature_map)\n",
    "\n",
    "print(\"Before ReLU:\")\n",
    "print(feature_map)\n",
    "\n",
    "print(\"\\nAfter ReLU:\")\n",
    "print(result)"
   ]
  }
 ],
