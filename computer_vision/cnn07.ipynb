   "source": [
    "from sklearn.datasets import load_digits\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "digits = load_digits()\n",
    "\n",
    "plt.imshow(digits.images[0], cmap=\"gray\")\n",
    "plt.title(f\"Label: {digits.target[0]}\")\n",
    "plt.axis(\"off\")\n",
    "\n",
    "plt.show()"
   ]
